# zshrc-optimize
# Source this file from your zshrc to optimize shell startup time

# Cache zsh completions - only rebuild once per day with security checks skipped
zsh_optimize_completions() {
  local zsh_version=$ZSH_VERSION
  
  # Create a version-specific cache directory for completions
  mkdir -p ~/.zsh/cache/$zsh_version
  
  # Configure completion caching with version-specific path
  zstyle ':completion:*' use-cache on
  zstyle ':completion:*' cache-path ~/.zsh/cache/$zsh_version
  
  # Skip all the checks for insecure directories and files
  autoload -Uz compinit
  if [[ -n ~/.zcompdump-$zsh_version(#qN.mh+24) ]]; then
    compinit -i -d ~/.zcompdump-$zsh_version
  else
    compinit -C -i -d ~/.zcompdump-$zsh_version
  fi
  
  # Compile the completion dump to increase speed
  { zcompile ~/.zcompdump-$zsh_version &>/dev/null } &!
}

# Lazy-load FZF
zsh_optimize_fzf() {
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_DEFAULT_OPTS='-i -e'
  if [[ -f "${HOME}/.fzf.zsh" ]]; then
    fzf-load() {
      unfunction fzf-load
      source "${HOME}/.fzf.zsh"
    }
    
    # Lazy-load fzf keybindings on first use
    fzf-history-widget() {
      fzf-load
      fzf-history-widget "$@"
    }
    
    fzf-file-widget() {
      fzf-load
      fzf-file-widget "$@"
    }
    
    fzf-cd-widget() {
      fzf-load
      fzf-cd-widget "$@"
    }
    
    # Find file and CD to its directory
    fzf-cd-to-file-widget() {
      fzf-load
      local file=$(fd --type f | fzf --preview 'bat --color=always --style=numbers --line-range=:500 {} 2>/dev/null || cat {}')
      if [[ -z "$file" ]]; then
        zle redisplay
        return 0
      fi
      local dir="$(dirname "$file")"
      zle push-line # Clear buffer. Auto-restored on next prompt.
      BUFFER="builtin cd -- ${(q)dir}"
      zle accept-line
      local ret=$?
      zle reset-prompt
      return $ret
    }
    zle -N fzf-cd-to-file-widget

    # Bind keys to the lazy-loaded functions
    bindkey '^R' fzf-history-widget
    bindkey '^T' fzf-file-widget
    bindkey '\ec' fzf-cd-widget
    bindkey '^F' fzf-cd-to-file-widget
  fi
}

# Optimize fastfetch to run less frequently
zsh_optimize_fastfetch() {
  # Only run fastfetch once per day or when FORCE_FASTFETCH=1
  if [[ "$FORCE_FASTFETCH" == "1" ]] || [[ ! -f ~/.fastfetch_today || $(date +%Y%m%d) != $(cat ~/.fastfetch_today 2>/dev/null) ]]; then
    command -v fastfetch >/dev/null 2>&1 && fastfetch
    date +%Y%m%d > ~/.fastfetch_today
  fi
}

# Optimize iTerm2 integration
zsh_optimize_iterm2() {
  # Only source iTerm2 integration if we're actually in iTerm2
  if [[ "$TERM_PROGRAM" == "iTerm.app" ]]; then
    source_ifexists "${HOME}/.iterm2_shell_integration.zsh"
  fi
}

# Apply all optimizations
zsh_apply_all_optimizations() {
  zsh_optimize_completions
  zsh_optimize_fzf
  zsh_optimize_fastfetch
  zsh_optimize_iterm2
  zsh_compile_all
}

# Compile zsh files for faster loading
zsh_compile_all() {
  local zsh_version=$ZSH_VERSION
  
  # Compile zshrc and related files if they've changed
  for file in ~/.zshrc ~/.zshrc-*(N); do
    [[ $file == *.zwc ]] && continue
    if [[ -f $file && (! -f $file.zwc || $file -nt $file.zwc) ]]; then
      zcompile $file
    fi
  done
  
  # Compile .zsh files in ~/.zsh and ~/.local/lib
  for dir in ~/.zsh ~/.local/lib; do
    [[ -d $dir ]] || continue
    for file in $dir/**/*.zsh(N); do
      if [[ -f $file && (! -f $file.zwc || $file -nt $file.zwc) ]]; then
        zcompile $file
      fi
    done
  done
  
  # Clean up old version caches (keep last 3 versions)
  if [[ -d ~/.zsh/cache ]]; then
    find ~/.zsh/cache -mindepth 1 -maxdepth 1 -type d | sort -r | tail -n +4 | xargs rm -rf 2>/dev/null
  fi
}

