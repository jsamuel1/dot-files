# Shared git config — symlinked to ~/.gitconfig-shared on every machine.
# Machine-local settings (user.email, credential overrides) live in
# ~/.gitconfig, a real file that includes this one.
# `git config --global` writes to ~/.gitconfig, never to this file.
[user]
        name = Joshua Samuel
[color]
        ui = true
[color "branch"]
        current = yellow reverse
        local = yellow
        remote = green
[color "diff"]
        meta = yellow bold
        frag = magenta bold
        old = red
        new = green
[core]
        autocrlf = input
        filemode = false
	# falls back to less on machines where delta isn't installed (yet)
	pager = command -v delta >/dev/null 2>&1 && delta || less
[diff]
	tool = nvimdiff
  guitool = bc4
	colorMoved = default
[difftool]
	prompt = false
[difftool "bc4"]
	trustExitCode = true
[difftool "nvimdiff"]
	cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
  trustExitCode = true

[merge]
  tool = nfugitive
	guitool = bc4
	keepbackup = false
	commit = no-edit
	conflictStyle = zdiff3
	edit = no
[mergetool "nvimdiff4"]
	cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[mergetool "nfugitive"]
	cmd = nvim -f -c "Gdiff" "$MERGED"
[mergetool "smerge"]
        cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
        trustExitCode = true
[protocol]
        version = 2
[github]
        user = jsamuel1
[alias]
        recent-branches = !git for-each-ref --count=15 --sort=-committerdate refs/heads/ --format='%(refname:short)'
        b = branch -v    # branch verbose
        amend = commit --amend
        ammend = commit --amend  # who wants to spelt it corectally?
        dc = diff --cached
        last = diff HEAD^
        # pull request
        pr = !git push -u origin HEAD && gh pr create --fill
        unstage = reset HEAD # remove files from index
        uncommit = reset --soft HEAD^ # go back before last commit, with files in uncommitted state
[apply]
        whitespace = nowarn
[branch]
        autosetupmerge = true
[push]
        default = upstream
	autoSetupRemote = true
[rerere]
        # remember my merges
        enabled = true
[pull]
        rebase = true
[help]
        autocorrect = 20
[secrets]
        providers = git secrets --aws-provider
        patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
        patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
        patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
        allowed = AKIAIOSFODNN7EXAMPLE
        allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
[credential]
        helper = cache
#        helper = !aws codecommit credential-helper $@
        UseHttpPath = true

[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[url "ssh://git.amazon.com"]
	insteadOf = https://git.amazon.com
[interactive]
	diffFilter = command -v delta >/dev/null 2>&1 && delta --color-only --line-numbers || cat
[delta]
	navigate = true
	dark = true
	features = zenburn
	hunk-header-style = omit
	line-numbers = true
	hyperlinks = true
[lfs "https://git.amazon.com/"]
	locksverify = false
[rebase]
	autosquash = true
[tag]
	forceSignAnnotated = false
[credential "https://git-codecommit.us-west-2.amazonaws.com"]
	helper = !aws --profile quebec codecommit credential-helper $@
	UseHttpPath = true
[ai "cadence"]
	org-id = aaec35b2-29ea-4f8b-a7b2-67ec9b27acde
	org = jsamuel1
[includeIf "gitdir:~/src/"]
	path = ~/.gitconfig-src
