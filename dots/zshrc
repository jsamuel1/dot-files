# shellcheck disable=SC2034,SC1091,SC1090
# when profiling, uncomment this line
#_ZSH_PROFILE=1

if [ "$_ZSH_PROFILE" ]; then
  zmodload zsh/zprof
fi
# Amazon Q pre block. Keep at the top of this file.
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.pre.zsh"
[[ -f "${HOME}/.local/share/amazon-q/shell/zshrc.pre.zsh" ]] && builtin source "${HOME}/.local/share/amazon-q/shell/zshrc.pre.zsh"

# Set INTERACTIVE=0 in non-interactive environments:
# - IntelliJ (INTELLIJ_ENVIRONMENT_READER is set)
# - VSCode (TERM_PROGRAM=vscode)
# - tmux sessions
# - When INTERACTIVE is already set to 0
# Otherwise, set INTERACTIVE=1
#
# VALUE | INTELLIJ/VSCODE/TMUX | INTERACTIVE 
# ----  | ------------------- | -----------
#  0    | detected            |  any value
#  1    | not detected        |  "1" or empty
#  0    | not detected        |  "0"
if [[ -n "$INTELLIJ_ENVIRONMENT_READER" || "$TERM_PROGRAM" == "vscode" || -n "$TMUX" || "$INTERACTIVE" == "0" ]]; then
  INTERACTIVE=0
else
  INTERACTIVE=1
fi

#ensure path arrays do not contain duplicates
typeset -gU cdpath fpath mailpath path PATH

OLDPATH=$PATH
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:/usr/local/sbin

source "$HOME/.zshrc-helpers"
source "$HOME/.zshrc-optimize"

prepend_path /home/linuxbrew/.linuxbrew/bin
prepend_path /opt/homebrew/bin
prepend_path /usr/local/opt/coreutils/libexec/gnubin
prepend_path "$HOME/.toolbox/bin"
append_path  "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
prepend_manpath /usr/local/opt/coreutils/libexec/gnuman
append_path "$HOME/.cargo/bin"
append_path "$HOME/go/bin"
append_path "$HOME/.dotnet/tools"
append_path "$HOME/.pyenv/bin"
append_path "${KREW_ROOT:-$HOME/.krew}/bin"
append_path /snap/bin
#append_path "$HOME/.local/share/mise/shims"
export PATH=$PATH:$OLDPATH

prepend_path /home/linuxbrew/.linuxbrew/bin
prepend_path /opt/homebrew/bin
prepend_path /usr/local/opt/coreutils/libexec/gnubin
prepend_path "$HOME/.toolbox/bin"
append_path  "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"
prepend_manpath /usr/local/opt/coreutils/libexec/gnuman
append_path "$HOME/.cargo/bin"
append_path "$HOME/go/bin"
append_path "$HOME/.dotnet/tools"
append_path "$HOME/.pyenv/bin"
append_path "${KREW_ROOT:-$HOME/.krew}/bin"
append_path /snap/bin
#append_path "$HOME/.local/share/mise/shims"
export PATH=$PATH:$OLDPATH

for script in "$HOME"/.local/lib/*.zsh; do
  . "$script"
done

# shellcheck disable=SC2206
fpath=(~/.zsh/completion ~/.local/lib/zsh-completions/src $fpath)
if type brew &>/dev/null; then
    FPATH="$(brew --prefix)/share/zsh/site-functions:$FPATH"
    FPATH="$(brew --prefix)/share/zsh-completions:$FPATH"
fi

# Apply completion optimizations
zsh_optimize_completions

source_ifexists "$HOME/.brazil_completion/zsh_completion"

# Apply FZF optimizations
zsh_optimize_fzf

ZSH_THEME="agnoster" # set by `omz`
HYPHEN_INSENSITIVE="true"
export UPDATE_ZSH_DAYS=5
DISABLE_UPDATE_PROMPT="true"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="yyyy-mm-dd"
ZSH_TMUX_AUTOSTART=true

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/local/bin/lesspipe ] && export LESSOPEN="|/usr/local/bin/lesspipe.sh %s"


if [[ "$OSTYPE" == "darwin"* ]]; then
  OSXPLUGIN=macos
fi

# now that docker isn't free anymore,
# I can't have it on all my machines :(
if [[ $(command -v docker >/dev/null 2>&1) ]]; then
  DOCKERPLUGIN=docker
fi

# shellcheck disable=SC2034 disable=SC2206
plugins=(
  aws
  dircycle
  ${DOCKERPLUGIN}
  fzf
  git
  github
  gpg-agent
  kubectl
  kubectx
  magic-enter
  ${OSXPLUGIN}
  mise
  sudo
  zsh-interactive-cd
)

export SHOW_AWS_PROMPT=false

if [ -d "$HOME/.local/share/sheldon/repos/github.com/ohmyzsh/ohmyzsh" ]; then
  export ZSH="$HOME/.local/share/sheldon/repos/github.com/ohmyzsh/ohmyzsh"
elif [ -d "$HOME/.oh-my-zsh" ]; then
  export ZSH="$HOME/.oh-my-zsh"
else
  echo "ZSH dir not found"
  return
fi

source "$ZSH/oh-my-zsh.sh"

# Use optimized iTerm2 integration
zsh_optimize_iterm2

command -v nvim >/dev/null 2>&1 && export EDITOR='nvim' && bindkey -v

if [ "$TILIX_ID" ] || [ "$VTE_VERSION" ]; then
  source_ifexists /etc/profile.d/vte.sh
fi

if [ "$INTERACTIVE" -gt 0 ]; then
  # Use optimized neofetch
  zsh_optimize_neofetch
  
  # Call show_smart_tip function if it exists
  if typeset -f show_smart_tip > /dev/null; then
    show_smart_tip
  fi
fi

export JAVA_TOOLS_OPTIONS="-Dlog4j2.formatMsgNoLookups=true"

# Run zsh_compile_all periodically (weekly) to optimize zsh files
if [[ ! -f ~/.zsh_compiled_date || $(( $(date +%s) - $(stat -f %m ~/.zsh_compiled_date) )) -gt 604800 ]]; then
  # Run in background to avoid slowing down startup
  {
    zsh_compile_all
    touch ~/.zsh_compiled_date
  } &!
fi

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi


# if you wish to use IMDS set AWS_EC2_METADATA_DISABLED=false
export AWS_EC2_METADATA_DISABLED=true


export PATH="${PATH}:${PHOENIX_HOME}/bin"

# Amazon Q post block. Keep at the bottom of this file.
[[ -f "${HOME}/.local/share/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/.local/share/amazon-q/shell/zshrc.post.zsh"
[[ -f "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/amazon-q/shell/zshrc.post.zsh"

if [ "$_ZSH_PROFILE" ]; then
  zprof
fi

# Amazon Q Developer Docker alias
alias q-dev='docker run -it --rm \
  -v "$(pwd):/home/dev/src" \
  -v "${HOME}/.aws/credentials:/home/dev/.aws/credentials:ro" \
  -v "${HOME}/.aws/config:/home/dev/.aws/config:ro" \
  -v "${HOME}/.aws/amazonq:/home/dev/.aws/amazonq:rw" \
  -v "${HOME}/Library/Application Support/amazon-q:/home/dev/.local/share/amazon-q:rw" \
  -v "${HOME}/Library/Caches/amazon-q:/home/dev/.cache/amazon-q:rw" \
  -v "${HOME}/.gitconfig:/home/dev/.gitconfig:ro" \
  -v "${HOME}/.ssh:/home/dev/.ssh:ro" \
  -e AWS_PROFILE \
  -e AWS_REGION \
  -e TZ=$(date +%Z) \
  amazon-q-dev'

# bun completions
[ -s "/Users/sauhsoj/.bun/_bun" ] && source "/Users/sauhsoj/.bun/_bun"


# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Amazon Q shared rules path
export AMAZONQ_RULES_PATH="$HOME/.aws/amazonq/rules"

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(kiro --locate-shell-integration-path zsh)"
