{
  "env": {
    "AWS_REGION": "us-west-2",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "CLAUDE_CODE_USE_MANTLE": "1"
  },
  "permissions": {
    "defaultMode": "dontAsk"
  },
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "AmazonBuilderCoreAIAgents-core@aim": true,
    "AmazonBuilderCoreAIAgents-pipeline-assistant@aim": true,
    "architecture@aws-claude-code-plugins": true,
    "AutonomousAICapabilities-core@aim": true,
    "aws-agents@agent-toolkit-for-aws": true,
    "aws-quick-work-factory@aws-quick-work-factory": true,
    "code-analysis@aws-claude-code-plugins": true,
    "context7@claude-plugins-official": true,
    "deployment@aws-claude-code-plugins": true,
    "documentation@aws-claude-code-plugins": true,
    "double-shot-latte@superpowers-marketplace": false,
    "huggingface-skills@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "performance@aws-claude-code-plugins": true,
    "plugin-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "SauhsojAIAgentCapabilties-all@aim": true,
    "superpowers@claude-plugins-official": true,
    "TalkStreamAgents-all@aim": true,
    "ux-design@aws-claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "aim": {
      "source": {
        "source": "directory",
        "path": "/Users/sauhsoj/.aim/cc-plugins"
      }
    },
    "aws-quick-work-factory": {
      "source": {
        "source": "directory",
        "path": "/Users/sauhsoj/src/AWSQuickWorkFactory"
      }
    }
  },
  "effortLevel": "high",
  "askUserQuestionTimeout": "5m",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
