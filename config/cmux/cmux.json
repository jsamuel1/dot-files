{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // cmux app behavior. Terminal rendering (font/colors/cursor/transparency)
  // lives in ~/.config/ghostty/config. Apply changes with: cmux reload-config

  "app": {
    "appearance": "system",
    "openMarkdownInCmuxViewer": true,
    "openSupportedFilesInCmux": true,
    "workspaceInheritWorkingDirectory": true,
    "warnBeforeClosingTab": true,
    "reorderOnNotification": true
  },

  "terminal": {
    // Matches iTerm "Copy to pasteboard on selection"
    "copyOnSelect": true,
    "showScrollBar": true,
    // Resume Claude/Codex/Kiro/etc. agent sessions after restart
    "autoResumeAgentSessions": true,
    // Hibernate idle background agents to reclaim RAM/CPU; resumes on focus.
    // Off by default; only kicks in above maxLiveTerminals (here 8).
    "agentHibernation": {
      "enabled": true,
      "idleSeconds": 120,
      "maxLiveTerminals": 8
    }
  },

  "automation": {
    // Allow external automation clients (e.g. the cmux-mcp server) to drive
    // cmux over its control socket. Default is "cmuxOnly" (cmux app only).
    "socketControlMode": "automation",
    // Claude Code is wrapped automatically when you run `claude` in a cmux pane
    "claudeCodeIntegration": true,
    // Kiro hooks (Feed approvals + notifications + session restore)
    "kiroIntegration": true,
    // minimal = approval cards only | standard = + mutating tools | verbose = all
    "kiroNotificationLevel": "standard",
    // Quiet the per-subagent spam when an agent fans out to sub-agents
    "suppressSubagentNotifications": true
  },

  "notifications": {
    // Visual + dock cues when a background pane/agent needs attention
    "paneFlash": true,
    "unreadPaneRing": true,
    "dockBadge": true,
    "showInMenuBar": true,
    "sound": "default"
  },

  "sidebar": {
    // Git-aware sidebar features
    "watchGitStatus": true,
    "showPullRequests": true,
    "makePullRequestsClickable": true,
    "showPorts": true,
    "showSSH": true,
    "showLog": true,
    "showProgress": true
  },

  "browser": {
    "defaultSearchEngine": "google",
    "openTerminalLinksInCmuxBrowser": true,
    "showSearchSuggestions": true
  },

  // Custom actions (also available in the command palette, Cmd+Shift+P).
  "actions": {
    // Launches the kermes-cdm2 self-healing tunnel + kanban dashboard.
    // Runs via an interactive login zsh so the `kermes-cdm2` shell function
    // (defined in ~/src/dot-files/local/lib/aliases.zsh) resolves.
    "kermes-kanban": {
      "type": "command",
      "command": "zsh -ilc 'kermes-cdm2'",
      "title": "Kermes",
      "subtitle": "kermes-cdm2 tunnel + kanban dashboard (localhost:8723)",
      "target": "newTabInCurrentPane",
      "palette": true,
      "icon": { "type": "symbol", "name": "checklist" }
    }
  },

  "ui": {
    // Surface tab bar buttons (top-right of a pane's tab bar). Listing these
    // replaces the defaults, so the built-ins are kept explicitly.
    "surfaceTabBar": {
      "buttons": [
        "cmux.newTerminal",
        "cmux.newBrowser",
        {
          "action": "kermes-kanban",
          "title": "Kermes",
          "tooltip": "kermes-cdm2 tunnel + kanban (localhost:8723)",
          "icon": { "type": "symbol", "name": "checklist" }
        },
        "cmux.splitRight",
        "cmux.splitDown"
      ]
    }
  }
}
