# Ghostty config for cmux — mirrors iTerm2 "Default" profile.
# cmux reads this for terminal rendering. Apply with: cmux reload-config

# --- Font (iTerm: MonaspiceKrNFM-Regular 14, bold+italic on) ---
font-family = MonaspiceKr Nerd Font Mono
font-size = 14
# Monaspace texture healing + coding ligatures (the features you had enabled in iTerm).
# Add stylistic sets if you want specific glyph variants, e.g. font-feature = ss01
font-feature = calt
font-feature = liga
# Boldens glyph stems so text stays legible on low-DPI (non-Retina) external
# monitors, where grayscale antialiasing otherwise renders it thin/blurry.
# strength is 0-255; nudge up/down and it hot-reloads on save.
font-thicken = true
font-thicken-strength = 148

# --- Cursor (iTerm: vertical bar, non-blinking) ---
cursor-style = bar
cursor-style-blink = false

# --- Window transparency (iTerm: Transparency 0, Blur off) ---
background-opacity = 1
background-blur = false

# --- Colors (Tomorrow Night-style preset, ported from the former
#     ~/Library/Application Support/com.mitchellh.ghostty/config so it is
#     version-controlled and identical on every machine). ---
background = #000000
foreground = #eaeaea
bold-color = #ffffff
cursor-color = #eeeeee
cursor-text = #ffffff
selection-background = #424242
selection-foreground = #eeeeee

# ANSI palette (0-15)
palette = 0=#000000
palette = 1=#d55555
palette = 2=#b9ca4a
palette = 3=#e7c547
palette = 4=#7aa6da
palette = 5=#c397d8
palette = 6=#70c0b1
palette = 7=#ffffff
palette = 8=#010101
palette = 9=#d55555
palette = 10=#b9ca4a
palette = 11=#e7c547
palette = 12=#7aa6da
palette = 13=#c397d8
palette = 14=#70c0b1
palette = 15=#ffffff
